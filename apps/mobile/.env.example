# The default AETHRA backend URL baked into the APK at build time.
# Leave empty to force the user to configure it in the Settings screen on first run.
# If set, the user can still override from Settings; the value is only a default.
#
# Example for same-Wi-Fi local AI on a laptop whose LAN IP is 192.168.1.42:
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000
EXPO_PUBLIC_API_URL=
