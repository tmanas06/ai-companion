# ===========================================
# CORE APPLICATION
# ===========================================
APP_ENV=development
APP_NAME=ai-companion
LOG_LEVEL=INFO

# ===========================================
# DATABASE (PostgreSQL + pgvector)
# ===========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_companion
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# ===========================================
# REDIS (Sessions, Cache, Rate Limiting)
# ===========================================
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10

# ===========================================
# AUTHENTICATION
# ===========================================
# Generate with: openssl rand -base64 64
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=./keys/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./keys/jwt_public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Privy Authentication
PRIVY_APP_ID=
PRIVY_APP_SECRET=
NEXT_PUBLIC_PRIVY_APP_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ===========================================
# PRIVACY & INFERENCE POLICY
# ===========================================
# Privacy enforcement mode:
# - strict-local: Only on-device loopback inference is permitted. Remote endpoints and cloud are blocked.
# - private-machine: Ollama on localhost or user-managed private machines permitted. Cloud blocked. (Default)
# - cloud-allowed: Hosted providers (OpenAI, Anthropic) permitted only when explicitly chosen.
PRIVACY_MODE=private-machine

# Explicit default provider override (e.g. ollama, openai, anthropic).
# In cloud-allowed mode, an explicit provider must be specified.
# In development/test, 'mock' can be explicitly set for testing without inference.
DEFAULT_PROVIDER=

# ===========================================
# AI PROVIDERS
# ===========================================
OPENAI_API_KEY=
OPENAI_ORG_ID=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.1:8b
OLLAMA_NUM_CTX=4096

# ===========================================
# EMBEDDINGS & VECTOR RAG
# ===========================================
# Embedding provider (defaults to local Ollama in strict-local/private-machine)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.5

# ===========================================
# OBJECT STORAGE (MinIO for local dev)
# ===========================================
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=ai-companion-assets
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=http://localhost:9000

# ===========================================
# EMAIL (Optional)
# ===========================================
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ai-companion.app
EMAIL_FROM_NAME=AI Companion

# ===========================================
# MONITORING (Optional)
# ===========================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=ai-companion-api
FASTAPI_OTEL_AUTO_CONFIGURE=true

# ===========================================
# FEATURE FLAGS
# ===========================================
ENABLE_VOICE=false
ENABLE_MEMORY_EXTRACTION=true
ENABLE_AVATAR_CUSTOMIZATION=true
ENABLE_OAUTH_GOOGLE=false
ENABLE_OAUTH_PRIVY=true
ENABLE_OAUTH_APPLE=false
ENABLE_OAUTH_GITHUB=true
